--- robot/soccer_perception_ros/config/detector.yaml
+++ candidate/soccer_perception_ros/config/detector.yaml
@@ -4,9 +4,9 @@
   ros__parameters:
     # 检测置信度阈值；越低越不漏检，但误检更多。
     det_conf: 0.45
-    # YOLO 权重路径；TensorRT 模式下仍可用于查找/导出 engine。
-    yolo_model: models/E01_baseline.pt
-    # YOLO 类别 ID；COCO 足球为 32，多类别用逗号分隔。
+    # E01 单类别部署 Engine；显式 .engine 只加载现有文件，不导出或重建。
+    yolo_model: models/E01_baseline.engine
+    # E01 的足球类别为 0。
     yolo_class_ids: "0"
     # 人体模型备选配置，需要时取消注释并注释上面的足球配置。
     # det_conf: 0.65
@@ -27,7 +27,9 @@
     half: true
     # 是否使用 TensorRT engine 加速 YOLO。
     yolo_tensorrt: true
-    # 统一 models 目录中的 engine；用 deployment/build_engine.sh 显式生成。
+    # 独立回退：none=原实现，a2=仅结果回传，graph=仅Graph，a2_graph=两者。
+    yolo_optimization: "a2_graph"
+    # 复用机器人现有 E01 Engine，与 yolo_model 指向同一文件。
     yolo_engine_path: "models/E01_baseline.engine"
     # TensorRT 最大 batch；双目同帧左右图建议至少 2。
     yolo_trt_batch: 2
