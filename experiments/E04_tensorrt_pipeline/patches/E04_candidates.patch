+"""CPU semantics/ownership tests; no robot, ROS, CUDA or model is opened."""
+from __future__ import annotations
+
+import ast
+import hashlib
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+
+import cv2
+import numpy as np
+import torch
+
+from soccer_perception.optimizations.preprocess import install
+
+
+def letterbox(image):
+    """Static 640x640 audited OpenCV geometry, used only as a unit-test fixture."""
+    height, width = image.shape[:2]
+    ratio = min(640 / height, 640 / width)
+    unpad = (int(round(width * ratio)), int(round(height * ratio)))
+    dw, dh = (640 - unpad[0]) / 2, (640 - unpad[1]) / 2
+    if (width, height) != unpad:
+        image = cv2.resize(image, unpad, interpolation=cv2.INTER_LINEAR)
+    return cv2.copyMakeBorder(image, int(round(dh - .1)), int(round(dh + .1)),
+                             int(round(dw - .1)), int(round(dw + .1)),
+                             cv2.BORDER_CONSTANT, value=(114, 114, 114))
+
+
+class Predictor:
+    def __init__(self, transform=letterbox):
+        self.model = SimpleNamespace(fp16=False, dynamic=False)
+        self.imgsz = [640, 640]
+        self.device = torch.device("cpu")
+        self.transform = transform
+
+    def pre_transform(self, images):
+        return [self.transform(image) for image in images]
+
+    def preprocess(self, im):
+        # Audited predictor operation sequence, independent of the candidate.
+        images = im
+        not_tensor = not isinstance(images, torch.Tensor)
+        if not_tensor:
+            value = np.stack(self.pre_transform(images))
+            if value.shape[-1] == 3:
+                value = value[..., ::-1]
+            value = value.transpose(0, 3, 1, 2)
+            value = np.ascontiguousarray(value)
+            value = torch.from_numpy(value)
+        else:
+            value = images
+        value = value.to(self.device)
+        value = value.half() if self.model.fp16 else value.float()
+        if not_tensor:
+            value /= 255
+        return value
+
+
+def detector(predictor=None):
+    return SimpleNamespace(model=SimpleNamespace(predictor=predictor or Predictor()))
+
+
+class PreprocessTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.old_threads = torch.get_num_threads()
+        torch.set_num_threads(1)
+
+    @classmethod
+    def tearDownClass(cls):
+        torch.set_num_threads(cls.old_threads)
+
+    def frames(self, height=37, width=69):
+        rng = np.random.RandomState(223)
+        return [rng.randint(0, 256, (height, width, 3), dtype=np.uint8),
+                rng.randint(0, 256, (height, width, 3), dtype=np.uint8)]
+
+    def test_c0_preserves_original_method_and_no_buffer(self):
+        obj = detector()
+        handle = install(obj, "c0")
+        self.assertNotIn("preprocess", vars(obj.model.predictor))
+        self.assertEqual(handle.describe()["effective"], "c0")
+        self.assertEqual(handle.describe()["host_buffer_allocations"], 0)
+        handle.restore()
+        handle.restore()
+        self.assertNotIn("preprocess", vars(obj.model.predictor))
+
+    def test_color_geometry_padding_order_and_no_input_mutation(self):
+        obj = detector()
+        images = self.frames()
+        images[0][:] = [10, 20, 30]
+        images[1][:] = [70, 80, 90]
+        originals = [image.copy() for image in images]
+        expected = obj.model.predictor.preprocess(images)
+        handle = install(obj, "c2")
+        actual = obj.model.predictor.preprocess(im=images)
+        self.assertTrue(torch.equal(actual, expected))
+        self.assertEqual(tuple(actual.shape), (2, 3, 640, 640))
+        self.assertEqual(actual.dtype, torch.float32)
+        self.assertTrue(actual.is_contiguous())
+        self.assertEqual(float(actual[0, 0, 320, 320]), float(torch.tensor(30 / 255, dtype=torch.float32)))
+        self.assertEqual(float(actual[1, 2, 320, 320]), float(torch.tensor(70 / 255, dtype=torch.float32)))
+        for before, after in zip(originals, images):
+            np.testing.assert_array_equal(before, after)
+        self.assertEqual(handle.describe()["effective"], "c2")
+
+    def test_new_inputs_and_saved_outputs_never_alias_host_buffer(self):
+        obj = detector()
+        handle = install(obj, "c2")
+        images = self.frames()
+        previous = obj.model.predictor.preprocess(images)
+        retained = previous.clone()
+        for index in range(12):
+            images[0][:] = index
+            images[1][:] = 255 - index
+            current = obj.model.predictor.preprocess(images)
+            self.assertFalse(torch.equal(current[0], current[1]))
+            self.assertNotEqual(current.data_ptr(), previous.data_ptr())
+        self.assertTrue(torch.equal(previous, retained))
+        info = handle.describe()
+        self.assertEqual(info["host_buffer_allocations"], 1)
+        self.assertEqual(info["host_tensor_view_allocations"], 1)
+        self.assertEqual(info["host_buffer_bytes"], 2 * 3 * 640 * 640)
+        self.assertEqual(info["success_count"], 13)
+        self.assertEqual(info["fallback_count"], 0)
+
+    def test_shape_change_falls_back_and_original_shape_can_resume(self):
+        obj = detector()
+        original = obj.model.predictor.preprocess
+        handle = install(obj, "c2")
+        first = self.frames()
+        obj.model.predictor.preprocess(first)
+        changed = self.frames(height=39)
+        self.assertTrue(torch.equal(obj.model.predictor.preprocess(changed), original(changed)))
+        self.assertEqual(handle.describe()["effective"], "c0")
+        self.assertIn("shape changed", handle.describe()["last_error"])
+        obj.model.predictor.preprocess(first)
+        self.assertEqual(handle.describe()["effective"], "c2")
+        self.assertEqual(handle.describe()["fallback_count"], 1)
+
+    def test_noncontiguous_images_and_asymmetric_geometry(self):
+        obj = detector()
+        original = obj.model.predictor.preprocess
+        handle = install(obj, "c2")
+        images = [image[:, ::-1] for image in self.frames()]
+        self.assertTrue(torch.equal(obj.model.predictor.preprocess(images), original(images)))
+        asymmetric = [images[0], images[1][:-1]]
+        self.assertTrue(torch.equal(obj.model.predictor.preprocess(asymmetric), original(asymmetric)))
+        self.assertEqual(handle.describe()["fallback_count"], 1)
+        self.assertIn("shapes differ", handle.describe()["last_error"])
+
+    def test_unsupported_batch_dtype_and_tensor_use_original(self):
+        for images in (self.frames()[:1], [image.astype(np.float32) for image in self.frames()],
+                       torch.full((2, 3, 640, 640), .75)):
+            with self.subTest(kind=type(images).__name__):
+                obj = detector()
+                original = obj.model.predictor.preprocess
+                handle = install(obj, "c2")
+                self.assertTrue(torch.equal(obj.model.predictor.preprocess(images), original(images)))
+                self.assertEqual(handle.describe()["fallback_count"], 1)
+                self.assertEqual(handle.describe()["host_buffer_allocations"], 0)
+
+    def test_changed_backend_configuration_uses_original(self):
+        for attribute, value in (("fp16", True), ("dynamic", True), ("imgsz", 640)):
+            with self.subTest(attribute=attribute):
+                obj = detector()
+                original = obj.model.predictor.preprocess
+                target = obj.model.predictor if attribute == "imgsz" else obj.model.predictor.model
+                setattr(target, attribute, value)
+                handle = install(obj, "c2")
+                images = self.frames()
+                self.assertTrue(torch.equal(obj.model.predictor.preprocess(images), original(images)))
+                self.assertEqual(handle.describe()["fallback_count"], 1)
+
+    def test_packing_exception_is_visible_and_calls_original(self):
+        obj = detector()
+        original = obj.model.predictor.preprocess
+        images = self.frames()
+        expected = original(images)
+        handle = install(obj, "c2")
+        with mock.patch("soccer_perception.optimizations.preprocess.np.copyto", side_effect=RuntimeError("test copy failure")):
+            self.assertTrue(torch.equal(obj.model.predictor.preprocess(images), expected))
+        self.assertIn("test copy failure", handle.describe()["last_error"])
+        self.assertEqual(handle.describe()["fallback_count"], 1)
+
+    def test_profile_matches_baseline_and_bounds_records_without_sync(self):
+        obj = detector()
+        images = self.frames()
+        expected = obj.model.predictor.preprocess(images)
+        handle = install(obj, "c1")
+        with mock.patch("torch.cuda.synchronize", side_effect=AssertionError("unexpected synchronization")):
+            for unused in range(3):
+                self.assertTrue(torch.equal(obj.model.predictor.preprocess(images), expected))
+        timings = handle.describe()["timings"]
+        self.assertEqual(set(timings), {"pre_transform", "stack", "color_layout_views", "contiguous_pack",
+                                        "from_numpy", "to_device", "dtype", "normalize"})
+        self.assertTrue(all(item["count"] == 3 for item in timings.values()))
+        self.assertEqual(handle.describe()["effective"], "c1")
+
+    def test_restore_is_idempotent_and_releases_host_storage(self):
+        obj = detector()
+        original = obj.model.predictor.preprocess
+        handle = install(obj, "c2")
+        obj.model.predictor.preprocess(self.frames())
+        with self.assertRaises(ValueError):
+            install(obj, "c1")
+        handle.restore()
+        handle.restore()
+        self.assertNotIn("preprocess", vars(obj.model.predictor))
+        self.assertIs(obj.model.predictor.preprocess.__func__, original.__func__)
+        self.assertEqual(handle.describe()["host_buffer_bytes"], 0)
+        self.assertEqual(handle.describe()["effective"], "c0")
+        replacement = install(obj, "c2")
+        replacement.restore()
+
+    def test_instance_method_restore_and_invalid_setup(self):
+        obj = detector()
+        original = obj.model.predictor.preprocess
+        obj.model.predictor.preprocess = original
+        handle = install(obj, "c2")
+        handle.restore()
+        self.assertIs(obj.model.predictor.preprocess, original)
+        with self.assertRaises(ValueError):
+            install(obj, "gpu_resize")
+        with self.assertRaises(ValueError):
+            install(SimpleNamespace(model=None), "c2")
+
+    @unittest.skipUnless(os.environ.get("E04_C_REFERENCE_RUN"), "set E04_C_REFERENCE_RUN for read-only Val/Golden CPU checks")
+    def test_all_frozen_val_inputs_against_cpu_baseline_and_robot_golden(self):
+        run = Path(os.environ["E04_C_REFERENCE_RUN"]).resolve()
+        manifest = json.loads((run / "val_cases/cases.json").read_text())
+        self.assertEqual(manifest["split"], "val")
+        self.assertFalse(manifest["test_accessed"])
+        # Execute the audited LetterBox class only, without importing an entire
+        # alternate Ultralytics install. This is source evidence, not a GPU test.
+        source = run / "audit/source/installed/ultralytics_0/data/augment.py"
+        parsed = ast.parse(source.read_text())
+        node = next(item for item in parsed.body if isinstance(item, ast.ClassDef) and item.name == "LetterBox")
+        namespace = {"np": np, "cv2": cv2}
+        exec(compile(ast.Module(body=[node], type_ignores=[]), str(source), "exec"), namespace)
+        transform = namespace["LetterBox"]((640, 640), auto=False, stride=32)
+        obj = detector(Predictor(lambda image: transform(image=image)))
+        original = obj.model.predictor.preprocess
+        handle = install(obj, "c2")
+        max_robot_error = 0.0
+        image_records = {item["name"]: item for item in manifest["images"]}
+        for pair in manifest["pairs"]:
+            images = []
+            for eye in ("left", "right"):
+                record = image_records[pair[eye]]
+                path = Path(record["image_source"]).resolve()
+                self.assertEqual(path.parent.name, "val")
+                self.assertEqual(path.parent.parent.name, "images")
+                self.assertEqual(hashlib.sha256(path.read_bytes()).hexdigest(), record["image_sha256"])
+                image = cv2.imread(str(path), cv2.IMREAD_COLOR)
+                self.assertIsNotNone(image)
+                images.append(image)
+            actual = obj.model.predictor.preprocess(images)
+            self.assertTrue(torch.equal(actual, original(images)), pair["pair_key"])
+            archive = run / "collection_v1/stage0_golden_attempt1" / (pair["pair_key"] + ".npz")
+            with np.load(archive, allow_pickle=False) as frozen:
+                error = float(np.max(np.abs(actual.numpy() - frozen["input"])))
+                max_robot_error = max(max_robot_error, error)
+                # CPU and CUDA float division may differ by one FP32 ULP.
+                self.assertLessEqual(error, np.finfo(np.float32).eps, pair["pair_key"])
+        self.assertEqual(handle.describe()["success_count"], 61)
+        self.assertEqual(handle.describe()["fallback_count"], 0)
+        print("C Val CPU check: pairs=61, CPU candidate/baseline exact; robot Golden max_abs=%g; cv2=%s; torch=%s" %
+              (max_robot_error, cv2.__version__, torch.__version__))
+
+
+if __name__ == "__main__":
+    unittest.main()
