+class Event:
+    def __init__(self, label, log):
+        self.label, self.log = label, log
+
+    def record(self, stream):
+        self.log.append((self.label, "record", stream))
+
+    def synchronize(self):
+        self.log.append((self.label, "synchronize"))
+
+    def elapsed_time(self, other):
+        self.log.append((self.label, "elapsed", other.label))
+        return 28.25
