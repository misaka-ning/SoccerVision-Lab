+        result = object()
+        backend = types.SimpleNamespace(forward=lambda data: log.append(("forward", data)) or result)
+        first, last = Event("start", log), Event("end", log)
+        clock = iter((1_000_000, 3_000_000, 6_000_000))
+        actual, timing = worker.timed_call(backend, value, None, "default", first, last, lambda: next(clock))
+        self.assertIs(actual, result)
+        self.assertEqual(log, [("start", "record", "default"), ("forward", value),
+                               ("end", "record", "default"), ("end", "synchronize"), ("start", "elapsed", "end")])
+        self.assertEqual(timing, dict(execution_cuda_ms=28.25, forward_call_wall_ms=2., execution_complete_wall_ms=5.))
+
+    def test_measure_writes_one_csv_record_per_completed_forward(self):
+        log, events = [], []
