{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoccerVision immutable archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "archive_id",
    "creation_time",
    "stage_id",
    "source_paths",
    "file_count",
    "total_bytes",
    "sha256",
    "package_path",
    "file_index_path",
    "file_index_sha256",
    "reason",
    "dependencies",
    "path_mapping",
    "restore_instructions",
    "verification",
    "source_removal_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "archive_id": {
      "type": "string",
      "minLength": 1
    },
    "creation_time": {
      "type": "string",
      "format": "date-time"
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_path": {
      "type": "string",
      "minLength": 1
    },
    "file_index_path": {
      "type": "string",
      "minLength": 1
    },
    "file_index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "research_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_base",
        "member_policy",
        "restore_base_policy",
        "conflict_policy"
      ],
      "properties": {
        "source_base": {
          "type": "string"
        },
        "member_policy": {
          "const": "preserve_full_workspace_relative_path"
        },
        "restore_base_policy": {
          "const": "new_empty_independent_directory_first"
        },
        "conflict_policy": {
          "const": "stop_without_overwrite"
        }
      }
    },
    "restore_instructions": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "member_validation",
        "restore_validation",
        "report_path"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "member_validation": {
          "enum": [
            "not_run",
            "full_stream_size_and_sha256"
          ]
        },
        "restore_validation": {
          "enum": [
            "not_run",
            "sample_restore",
            "full_restore"
          ]
        },
        "report_path": {
          "type": "string"
        }
      }
    },
    "source_removal_authorized": {
      "const": false,
      "description": "This manifest never authorizes removal. Any future removal requires a separate approved exact operation log."
    }
  }
}
